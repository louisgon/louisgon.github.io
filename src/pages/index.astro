---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import CaseShell from '../components/CaseShell.astro';
import Backdrop from '../components/Backdrop.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import PilotLog from '../components/PilotLog.astro';
import Stack from '../components/Stack.astro';
import Work from '../components/Work.astro';
import Clients from '../components/Clients.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import ReviewTab from '../components/ReviewTab.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Cursor />
  <CaseShell />
  <Backdrop />
  <Nav />
  <MobileMenu />
  <Hero />
  <main>
    <PilotLog />
    <Stack />
    <Work />
    <Clients />
    <About />
    <Contact />
  </main>
  {__REVIEW__ && <ReviewTab />}
  <Footer />
</Base>
