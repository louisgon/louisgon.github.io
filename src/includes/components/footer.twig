{# Computed Variables #}
{% set socialItems = [
  {
    href: 'https://github.com/louisgon',
    icon: 'github',
    label: 'GitHub',
  },
  {
    href: 'https://twitter.com/louisgon',
    icon: 'twitter',
    label: 'Twitter',
  },
  {
    href: 'https://www.linkedin.com/in/lougon/',
    icon: 'linkedin',
    label: 'LinkedIn',
  },
] %}

{# HTML #}
{% embed '@layouts/component.twig' with {
  containerType: 'full',
  name: 'footer',
  tag: 'footer',
} %}
  {% block content %}
    <div class="c-footer__inner">
      <div class="c-footer__inner-left">
        {% include '@objects/button.twig' with {
          animateIn: 'fadeLeft',
          classes: 'c-footer__logo',
          href: '/',
          icon: 'logo',
        } only %}

        {% include '@objects/text.twig' with {
          animateIn: 'fade',
          classes: 'c-footer__text',
          content: 'This website was built with Vite &amp; Twig. Designed in Figma and coded in Visual Studio Code by yours truly.',
          style: 'caption',
          tag: 'span',
        } only %}
      </div>

      <div class="c-footer__inner-right">
        <nav class="c-footer__social" aria-label="Footer Social Links">
          {% for socialItem in socialItems %}
            {% include '@objects/button.twig' with {
              animateIn: 'fadeRight',
              aria: {
                label: socialItem.label,
              },
              classes: 'c-footer__social-link',
              href: socialItem.href,
              icon: socialItem.icon,
              style: 'icon-control',
              target: '_blank',
            } only %}
          {% endfor %}
        </nav>
      </div>
    </div>
  {% endblock %}
{% endembed %}
