{# HTML #}
{% embed '@layouts/component.twig' with {
  containerType: 'full',
  module: 'Header',
  name: 'header',
  tag: 'header',
} %}
  {% block content %}
    <div class="c-header__inner">
      <a class="c-header__logo" href="/" data-animate-in="fadeLeft">
        {% include '@icons/logo.svg' %}
      </a>

      <button class="c-header__theme" role="switch" aria-checked="true" aria-label="Use Dark Theme" data-animate-in="fadeRight">
        {% for themeIcon in ['moon', 'sun'] %}
          {% include '@objects/icon.twig' with {
            classes: classList({
              modifiers: [themeIcon],
              name: 'c-header__theme-icon',
            }),
            name: themeIcon,
          } only %}
        {% endfor %}
      </button>
    </div>
  {% endblock %}
{% endembed %}
