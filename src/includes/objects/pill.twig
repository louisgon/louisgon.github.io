{# Passed Variables #}
{% set classes = classes|default('') %}
{% set label = label|default('') %}
{% set modifiers = modifiers|default([]) %}

{# HTML #}
<div class="{{ classList({
  classes: classes,
  name: 'o-pill',
  modifiers: modifiers,
}) }}">
  <div class="o-pill__label">
    {{ label }}
  </div>
</div>
