{# Passed Variables #}
{% set animateIn = animateIn|default('') %}
{% set classes = classes|default('') %}
{% set label = label|default('') %}
{% set modifiers = modifiers|default([]) %}

{# HTML #}
<div {{ htmlAttr({
  animateIn: animateIn,
  class: {
    classes: classes,
    name: 'o-pill',
    modifiers: modifiers,
  },
}) }}>
  <div class="o-pill__label">
    {{ label }}
  </div>
</div>
