{# Passed Variables #}
{% set animateIn = animateIn|default('fadeY') %}
{% set items = items|default([]) %}
{% set name = name|default('') %}
{% set modifiers = modifiers|default([]) %}
{% set spacingType = spacingType|default('content') %}

{# HTML #}
<div class="{{ classList({
  classes: classes,
  name: 'o-content',
  modifiers: modifiers,
}) }}">
  {% for item in items %}
    {% set itemData = item.data|default({}) %}
    {% set itemType = item.type|default('') %}

    {% include '@objects/' ~ item.type ~ '.twig' with itemData|merge({
      animateIn: item.animateIn|default(animateIn),
      classes: classList({
        classes: itemData.classes|default(''),
        name: 'o-content__item',
        modifiers: [item.type],
        spacing: {
          options: item.spacingOptions|default({}),
          type: item.spacingType|default(spacingType),
        },
      }),
    }) only %}
  {% endfor %}
</div>
