{# Passed Variables #}
{% set bodyData = bodyData|default({}) %}
{% set navItems = navItems|default([]) %}
{% set page = page|default('') %}

{# HTML #}
<body {{ htmlAttr({
  class: 'l-body',
  data: {
    theme: 'dark',
  },
  module: 'Body',
}) }}>
  {% include '@components/header.twig' %}

  {% include '@components/nav.twig' with {
    items: navItems,
    page: page,
  } only %}

  <main class="l-body__main">
    {% include '@partials/page/' ~ page ~ '.twig' ignore missing %}
  </main>

  {% include '@components/footer.twig' %}

  {% include '@components/cursor.twig' %}

  <div class="l-body__loader">
    {% include '@objects/spinner.twig' with {
      classes: 'l-body__loader-spinner',
    } only %}
  </div>

  {% for trigger in ['nav', 'top-of-page'] %}
    {% include '@components/trigger.twig' with {
      classes: 'l-body__trigger',
      type: trigger,
    } only %}
  {% endfor %}

  {% include '@partials/script-json.twig' with {
    classes: 'l-body__data',
    data: bodyData,
  } only %}
</body>
