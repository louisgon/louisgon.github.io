{# Passed Variables #}
{% set constants = constants|default({}) %}
{% set page = page|default('') %}

{# HTML #}
<!DOCTYPE html>
<html lang="en" xml:lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <title>Portfolio</title>
    <meta charset="utf-8" />
    <meta name="title" content="Portfolio" />
    <meta name="description" content="Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {# Preload fonts #}
    <link rel="preload" href="/src/scss/fonts.scss" as="style" />

    {# Stylesheets #}
    <link rel="stylesheet" href="/src/scss/fonts.scss">
    <link rel="stylesheet" href="/src/scss/main.scss">
  </head>

  {% include '@layouts/body.twig' with constants|merge({
    page: page
  }) only %}
</html>