---
import Divider from './Divider.astro';
import Heading from './Heading.astro';
import { srcset, webp } from '../lib/assets';

const [pilot, pilotSet] = await Promise.all([webp('pilot'), srcset('pilot')]);
---
<section class="s" id="pilot">
  <Divider n={4} name="The pilot" />
  <div class="holo-wrap rv"><div class="holo" id="holo"><img id="pilotImg" alt="Portrait of Louis Gonzalez" data-src={pilot} data-srcset={pilotSet} sizes="(max-width: 860px) 300px, 440px" loading="lazy" /><div class="lines" aria-hidden="true"></div><div class="sheen" aria-hidden="true"></div><div class="rim" aria-hidden="true"></div><div class="tag mono"><i>●</i> Comms · Louis G.</div><div class="sig mono"><span>Signal <b id="sigV">98</b>%</span><span>Lag <b id="sigL">0.42</b>s</span><span>Dallas, TX</span></div><div class="hud"></div></div></div>
  <div class="pt" data-stage>
    <Heading lines={['Hi, I’m', 'Louis']} />
    <p class="lead st" style="--i:2">I started building for the web in 2013, freelancing for big brands before moving into agency teams. At Goodfolks I look after long-running client platforms, and the part I care about most is the years after launch, when a site has to stay fast, stable and easy for the client to run.</p>
    <ol class="roles" id="roles">
      <li class="now"><span class="yr disp">2024<small>to now</small></span><div><b>Senior Developer</b> <span class="co">· Goodfolks</span><em>Long-term client platforms, end to end.</em></div></li>
      <li><span class="yr disp">2022<small>to 2024</small></span><div><b>Web Developer</b> <span class="co">· Goodfolks</span><em>Air Mail, Azul, Puck and more.</em></div></li>
      <li><span class="yr disp">2020<small>to 2022</small></span><div><b>Frontend Developer</b> <span class="co">· Calibrate</span><em>Twenty-plus builds.</em></div></li>
      <li><span class="yr disp">2013<small>to 2020</small></span><div><b>Freelance</b><em>Uber, Timberland, Birkenstock, ASICS, Qantas.</em></div></li>
    </ol>
  </div>
</section>
