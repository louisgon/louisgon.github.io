---
import { nn } from '../lib/sections';

const CLIENTS = ['Anne Graham Lotz', 'Azul', 'Puck', 'Air Mail', 'Esses', 'Perry Weather', 'Kioti', 'Rockit Apple', 'UMF', 'Uber', 'Timberland', 'Birkenstock', 'ASICS', 'Qantas'];
---
<section class="s" id="clients" aria-label="Clients" data-stage>
  <div class="lbl mono k st" style="--i:0">Brands and teams I’ve built for <button type="button" class="mqp mono" id="mqp" aria-pressed="false">Pause</button></div>
  <div class="marquee" id="marquee">
    {[...CLIENTS, ...CLIENTS].map((c, i) => <span aria-hidden={i >= CLIENTS.length ? 'true' : undefined}><small aria-hidden="true">{nn((i % CLIENTS.length) + 1)}</small>{c}</span>)}
  </div>
</section>
