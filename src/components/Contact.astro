---
import Divider from './Divider.astro';
---
<section class="s" id="contact">
  <Divider n={5} name="Transmission" />
  <div class="tx-signal">
    <div class="sg" data-stage>
      <p class="sg-lead st" style="--i:2">Building something? Tell me about it.</p>
      <canvas id="osc" aria-hidden="true" class="st" style="--i:3"></canvas>
      <a class="sg-mail disp st" id="sgMail" href="mailto:mail@louis.gg" style="--i:4">mail@louis.gg</a>
      <div class="sg-row mono st" style="--i:5"><a href="https://github.com/louisgon" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>GitHub<span class="sr"> (opens in a new tab)</span></a><a href="https://www.linkedin.com/in/lougon/" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>LinkedIn<span class="sr"> (opens in a new tab)</span></a></div>
    </div>
  </div>
</section>
